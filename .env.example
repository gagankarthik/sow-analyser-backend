# Copy to .env and fill in your values. Never commit .env.

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Project ───────────────────────────────────────────────────────────────────
PROJECT_NAME=blue-iq-sow
STAGE=dev

# ── OpenAI (injected directly into Lambda env — no Secrets Manager needed) ───
OPENAI_API_KEY=sk-proj-...
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
# Optional per-task models (empty = inherit CHAT_MODEL). See README "Models and
# accuracy settings" for which to raise first.
EXTRACTION_MODEL=
CLAUSE_MODEL=
VALIDATION_MODEL=
RAG_MODEL=
# Vector size of the search index. Must equal what EMBEDDING_MODEL returns; a
# mismatch stops the embed stage with a clear error rather than corrupting search.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS=false
# Limits (defaults shown; all optional)
LLM_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_S=180
OPENAI_MAX_ATTEMPTS=4
CLASSIFY_MAX_INPUT_TOKENS=60000
CHAT_MAX_OUTPUT_TOKENS=16000
CHAT_MAX_OUTPUT_TOKENS_MAX=32000
CLASSIFY_REUSE_UNCHANGED=true

# ── AWS Resources (auto-populated by Terraform; set manually for local dev) ───
DDB_TABLE_NAME=blue-iq-sow-dev-main
RAW_BUCKET=blue-iq-sow-dev-raw-<account-id>
PROCESSED_BUCKET=blue-iq-sow-dev-processed-<account-id>
OPENSEARCH_ENDPOINT=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXTJS_ORIGIN=http://localhost:3000

# ── Guardrails / data protection ──────────────────────────────────────────────
# AI provider that may receive client data. Must be on the no-train allowlist in
# lambdas/shared/guardrails.py (openai | openai-zdr | bedrock) or every AI call
# fails closed. Use "openai-zdr" once Zero Data Retention is approved.
AI_PROVIDER=openai
# Master switch for PII redaction (allowlist + audit log are always enforced).
GUARDRAILS_ENABLED=true
# Entity classes pseudonymised before text leaves AWS. MONEY/DATE/PARTY are
# excluded by default because the extraction stage must read those figures.
REDACT_CLASSES=EMAIL,PHONE,SSN,CREDIT_CARD,IP

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_NEPTUNE=false
ENABLE_OPENSEARCH=true
ENABLE_APPSYNC=true
